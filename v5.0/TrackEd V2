<section id="researcher-dashboard" class="screen">
<div class="topbar"><h2>Researcher / M&E Dashboard</h2><span class="role">Evidence quality and claims</span></div>
<div class="grid">
<div><label>Platform</label><select><option>All</option><option>Khan Academy</option><option>DIKSHA</option><option>Byju's</option></select></div>
<div><label>Grade</label><select><option>All</option><option>Grade 6</option><option>Grade 7</option><option>Grade 8</option></select></div>
<div><label>Subject</label><select><option>All</option><option>Math</option><option>Science</option><option>English</option></select></div>
<div><label>Evidence status</label><select><option>Complete</option><option>Partial</option><option>Illustrative only</option></select></div>
</div>
<div class="grid">
<div class="card"><h3>Matched assessment evidence</h3><p>68% matched pre/post.</p><div class="progress"><div class="fill" style="width:68%"></div></div></div>
